meta {
  name: Decline
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/workspaceInvitation/decline
  body: json
  auth: inherit
}

body:json {
  {
    "invitationId": "{{invitationId}}"
  }
}

docs {
  # 拒絕邀請

  - Route: `POST /v1/api/workspaceInvitation/decline`
  - Auth: 有效 Session，且為該有效 PENDING 邀請的受邀者
  - 成功：200 / null，message「已拒絕邀請」；不建立 WorkspaceMember

  | 欄位 | 型別 | 規則 |
  |---|---|---|
  | invitationId | `string` | UUID v4 |
}
