meta {
  name: AddCategoryInvalidColor
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/board/addCategory
  body: json
  auth: inherit
}

body:json {
  {
    "projectId": "{{projectId}}",
    "name": "文件",
    "colorKey": "red"
  }
}

tests {
  test('回應 400 / ValidationError', () => {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().code).to.equal(1000);
  });
}

docs {
  # 建立類別：色票不正確

  `colorKey` 不在 contracts `CARD_CATEGORY_COLOR_KEYS` 內時回 400 / ValidationError (1000)，不會建立類別。

  2026-11-04 Board 規格 A+1-2。
}
