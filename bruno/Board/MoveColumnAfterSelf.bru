meta {
  name: MoveColumnAfterSelf
  type: http
  seq: 21
}

patch {
  url: {{baseUrl}}/board/moveColumn
  body: json
  auth: inherit
}

body:json {
  {
    "columnId": "{{columnId}}",
    "afterColumnId": "{{columnId}}"
  }
}

tests {
  test('回應 400', () => {
    expect(res.getStatus()).to.equal(400);
  });

  test('code 為 ValidationError (1000)', () => {
    expect(res.getBody().code).to.equal(1000);
  });
}

docs {
  # 移動欄位：放在自己後面（錯誤案例）

  - 預期：400 / ValidationError (1000)

  `afterColumnId` 不可等於 `columnId`；service 在查資料庫之前就擋下。
}
