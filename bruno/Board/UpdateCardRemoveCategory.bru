meta {
  name: UpdateCardRemoveCategory
  type: http
  seq: 14
}

patch {
  url: {{baseUrl}}/board/updateCard
  body: json
  auth: inherit
}

body:json {
  {
    "cardId": "{{categoryCardId}}",
    "categoryId": null,
    "expectedVersion": {{categoryCardVersion}}
  }
}

tests {
  test('回應 200，只送 categoryId: null 也算修改（不回 400）', () => {
    expect(res.getStatus()).to.equal(200);
  });

  test('類別被移除，其他內容不變，version +1', () => {
    const card = res.getBody().data.card;
    expect(card.categoryId).to.equal(null);
    expect(card.title).to.equal('有類別的卡片');
    expect(card.version).to.equal(Number(bru.getVar('categoryCardVersion')) + 1);
  });
}

docs {
  # 移除卡片類別

  `categoryId: null` 代表移除類別；沒送 `categoryId` 代表不改。請先執行 `AddCardWithCategory`。

  2026-11-04 Board 規格 A+1-3（Q11）。
}
