NODE_ENV=test

PORT=3001
FRONTEND_URL=http://localhost:5173

POSTGRES_USER=kanban_e2e
POSTGRES_PASSWORD=kanban_e2e
POSTGRES_DB=kanban_e2e
DATABASE_URL=postgresql://kanban_e2e:kanban_e2e@localhost:5433/kanban_e2e
REDIS_URL=redis://localhost:6380

SALT_ROUNDS=4
SESSION_EXPIRE_DAY=7
SESSION_ROTATE_MINUTE=15
MAX_DEVICE=5

EMAIL_TRANSPORT=smtp
SMTP_USER=test@example.com
SMTP_PASSWORD=unused-in-e2e
SMTP_HOST=localhost
SMTP_PORT=465
MAIL_FROM=test@example.com
VERIFY_MAIL_EXPIRE_MINUTE=30
RATE_LIMIT_VERIFY_EMAIL_SECONDS=60

AVATAR_STORAGE_ROOT=./storage-e2e/media
AVATAR_TEMP_ROOT=./storage-e2e/temp
AVATAR_PUBLIC_BASE_URL=http://localhost:3001/media

# 登入與註冊 rate limit：E2E 全部來自 127.0.0.1 且大量註冊，上限調高；限流測試自行設定低門檻
RATE_LIMIT_LOGIN_EMAIL_IP_MAX=10000
RATE_LIMIT_LOGIN_EMAIL_IP_WINDOW_SECONDS=900
RATE_LIMIT_LOGIN_IP_MAX=10000
RATE_LIMIT_LOGIN_IP_WINDOW_SECONDS=900
RATE_LIMIT_LOGIN_EMAIL_MAX=10000
RATE_LIMIT_LOGIN_EMAIL_WINDOW_SECONDS=3600
RATE_LIMIT_SIGNUP_IP_MAX=10000
RATE_LIMIT_SIGNUP_IP_WINDOW_SECONDS=3600

# Client 與 API 之間自己控制的 reverse proxy 層數（docs/features/rate-limit.md §6）；開發 0，正式環境經 Nginx 為 1
TRUST_PROXY_HOPS=0
