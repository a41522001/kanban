# 正式環境（compose.prod.yml）的環境變數範本。
# 在 VM 複製成 /app/backend/.env.prod、chmod 600，填入留空的值；不要把填好的檔案提交到 Git。
# backend、worker、postgres 三個服務共用這個檔案。修改後需 docker compose up -d --force-recreate backend worker。
# 部署流程見 docs/operations/deployment.md。

NODE_ENV=production
# 必填：Nginx 轉發到 backend:4001；未設定時預設 3000，Nginx 會連不到
PORT=4001
# 使用者在瀏覽器開啟的網址（CORS 與驗證信連結），例如 http://<VM 外部 IP> 或 https://<網域>
FRONTEND_URL=

# PostgreSQL 容器第一次初始化 volume 時使用；之後修改不會變更資料庫密碼
POSTGRES_USER=kanban
POSTGRES_PASSWORD=
POSTGRES_DB=kanban
# 格式：postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@postgres:5432/<POSTGRES_DB>?schema=public（host 為 service 名稱 postgres）
DATABASE_URL=

# host 為 service 名稱 redis；目前 schema 只接受 redis://
REDIS_URL=redis://redis:6379
SALT_ROUNDS=10
SESSION_EXPIRE_DAY=7
SESSION_ROTATE_MINUTE=15
MAX_DEVICE=5

EMAIL_TRANSPORT=smtp
SMTP_USER=
SMTP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
MAIL_FROM=
VERIFY_MAIL_EXPIRE_MINUTE=30
RATE_LIMIT_VERIFY_EMAIL_SECONDS=60

# 頭像：正式環境必須使用 GCS（docs/features/avatar.md §0.4、docs/operations/vm-setup-runbook.md §10.1）。
# NODE_ENV=production 時 driver 為 local 會啟動失敗；身分使用 VM 附加的服務帳號，不可設定 GCS_CLIENT_EMAIL／GCS_PRIVATE_KEY。
AVATAR_STORAGE_DRIVER=gcs
AVATAR_MEDIA_BUCKET=flowboard-prod-avatar-media
AVATAR_TEMP_BUCKET=flowboard-prod-avatar-temp
# https://media.<網域>（經 Cloudflare Worker，步驟 11-4）
AVATAR_PUBLIC_BASE_URL=

# 正式環境目前沒有 Seq；不設定時 log 只輸出到容器的 stdout
# SEQ_URL=

# 登入與註冊 rate limit（docs/features/rate-limit.md §2、§7）
RATE_LIMIT_LOGIN_EMAIL_IP_MAX=5
RATE_LIMIT_LOGIN_EMAIL_IP_WINDOW_SECONDS=900
RATE_LIMIT_LOGIN_IP_MAX=50
RATE_LIMIT_LOGIN_IP_WINDOW_SECONDS=900
RATE_LIMIT_LOGIN_EMAIL_MAX=100
RATE_LIMIT_LOGIN_EMAIL_WINDOW_SECONDS=3600
RATE_LIMIT_SIGNUP_IP_MAX=20
RATE_LIMIT_SIGNUP_IP_WINDOW_SECONDS=3600

# 使用者與 backend 之間只有 Nginx 一層（docs/features/rate-limit.md §6）。
# 設 0 會讓所有人共用 Nginx 的 IP、互相擋住；設得比實際層數多，攻擊者可偽造 X-Forwarded-For 繞過 IP 限制。
# 之後在 Nginx 前面加 Cloudflare 或 Load Balancer 時改成 2。
TRUST_PROXY_HOPS=1
