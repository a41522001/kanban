NODE_ENV=development
PORT=4001
FRONTEND_URL=http://localhost:5173

POSTGRES_USER=kanban
POSTGRES_PASSWORD=change_me
POSTGRES_DB=kanban
DATABASE_URL=postgresql://kanban:change_me@localhost:5432/kanban?schema=public

REDIS_URL=redis://localhost:6379
SALT_ROUNDS=10
SESSION_EXPIRE_DAY=7
SESSION_ROTATE_MINUTE=15
MAX_DEVICE=5

EMAIL_TRANSPORT=smtp
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-google-app-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
MAIL_FROM=your-email@gmail.com
VERIFY_MAIL_EXPIRE_MINUTE=30
RATE_LIMIT_VERIFY_EMAIL_SECONDS=60

AVATAR_STORAGE_ROOT=./storage/media
AVATAR_TEMP_ROOT=./storage/temp
AVATAR_PUBLIC_BASE_URL=http://localhost:4001/media

# 本機有啟動 Seq（docker compose up -d seq）時取消註解，log 會同時送進 Seq
# SEQ_URL=http://localhost:5341

# Seq 管理員初始密碼，只在第一次初始化時使用；第一次登入時 Seq 會要求更改（官方設計）
SEQ_FIRSTRUN_ADMINPASSWORD=
