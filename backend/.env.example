NODE_ENV=development
PORT=4001
FRONTEND_URL=http://localhost:5173

POSTGRES_USER=kanban
POSTGRES_PASSWORD=change_me
POSTGRES_DB=kanban
DATABASE_URL=postgresql://kanban:change_me@localhost:5432/kanban?schema=public

REDIS_URL=redis://localhost:6379
SALT_ROUNDS=10
SESSION_EXPIRE_DAY=7
SESSION_ROTATE_MINUTE=15
MAX_DEVICE=5

EMAIL_TRANSPORT=smtp
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-google-app-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
MAIL_FROM=your-email@gmail.com
VERIFY_MAIL_EXPIRE_MINUTE=30
RATE_LIMIT_VERIFY_EMAIL_SECONDS=60

AVATAR_STORAGE_ROOT=./storage/media
AVATAR_TEMP_ROOT=./storage/temp
AVATAR_PUBLIC_BASE_URL=http://localhost:4001/media

# 頭像儲存位置：local（預設）或 gcs（docs/features/avatar.md §0.4.2）
AVATAR_STORAGE_DRIVER=local
# 改用 gcs 時取消註解並填入 dev bucket，AVATAR_PUBLIC_BASE_URL 同時改為 https://storage.googleapis.com/flowboard-dev-avatar-media
# 不使用的變數請保持整行註解：寫成 KEY= 會被當成空字串而驗證失敗
# AVATAR_MEDIA_BUCKET=flowboard-dev-avatar-media
# AVATAR_TEMP_BUCKET=flowboard-dev-avatar-temp
# dev 服務帳號 kanban-dev 的 JSON 金鑰中的 client_email 與 private_key；兩者必須同時設定，且不可放進 .env.prod
# private_key 壓成一行，以 \n 表示換行並加上雙引號
# GCS_CLIENT_EMAIL=kanban-dev@<GCP 專案 ID>.iam.gserviceaccount.com
# GCS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# 本機有啟動 Seq（docker compose up -d seq）時取消註解，log 會同時送進 Seq
# SEQ_URL=http://localhost:5341

# Seq 管理員初始密碼，只在第一次初始化時使用；第一次登入時 Seq 會要求更改（官方設計）
SEQ_FIRSTRUN_ADMINPASSWORD=

# 登入與註冊 rate limit（docs/features/rate-limit.md §7）
RATE_LIMIT_LOGIN_EMAIL_IP_MAX=5
RATE_LIMIT_LOGIN_EMAIL_IP_WINDOW_SECONDS=900
RATE_LIMIT_LOGIN_IP_MAX=50
RATE_LIMIT_LOGIN_IP_WINDOW_SECONDS=900
RATE_LIMIT_LOGIN_EMAIL_MAX=100
RATE_LIMIT_LOGIN_EMAIL_WINDOW_SECONDS=3600
RATE_LIMIT_SIGNUP_IP_MAX=20
RATE_LIMIT_SIGNUP_IP_WINDOW_SECONDS=3600

# Client 與 API 之間自己控制的 reverse proxy 層數（docs/features/rate-limit.md §6）；開發 0，正式環境經 Nginx 為 1
TRUST_PROXY_HOPS=0
